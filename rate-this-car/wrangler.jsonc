{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rate-this-car",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  },
  // The database is created automatically on the first `wrangler deploy`,
  // and the Worker creates its tables on first use: no manual setup needed.
  "d1_databases": [{ "binding": "DB", "database_name": "rate-this-car" }],
  // Daily clean-up: wipes anti-abuse IP hashes after 48 h and ratings after RETENTION_DAYS.
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "RETENTION_DAYS": "365",
    // Shown on the About page for removal requests, e.g. "contact@example.com".
    "CONTACT_EMAIL": ""
  },
  "observability": { "enabled": true }
}
